Group {
 inputs 2
 name AutoKey_Keymix
 knobChanged {
def _set_enabled(node, knob_names, state):
    s = bool(state)
    for name in knob_names:
        if name in node.knobs():
            node[name].setEnabled(s)

def _get_mix(node):
    mk = node.node('Master_Keymix')
    if not mk:
        nuke.message('Missing Master_Keymix')
        return None
    return mk['mix']

def _read_int(node, knob_name):
    return int(node[knob_name].value())

def _apply_single_frame(mix, f):
    mix.clearAnimated()
    mix.setAnimated()
    mix.setValueAt(0, f - 1)
    mix.setValueAt(1, f)
    mix.setValueAt(0, f + 1)

def _apply_frame_range(mix, first, last):
    mix.clearAnimated()
    mix.setAnimated()
    mix.setValueAt(0, first - 1)
    mix.setValueAt(1, first)
    mix.setValueAt(1, last)
    mix.setValueAt(0, last + 1)

def _apply_fade(mix, first, last, fade_start, fade_end):
    mix.clearAnimated()
    mix.setAnimated()
    mix.setValueAt(0, fade_start)
    mix.setValueAt(1, first)
    mix.setValueAt(1, last)
    mix.setValueAt(0, fade_end)

def _update_animation(node):
    mix = _get_mix(node)
    if mix is None:
        return
    frame_range_on = bool(node['Frame_Range'].value())
    fade_on = bool(node['Fade'].value())
    first = _read_int(node, 'First_Frame')
    last = _read_int(node, 'Last_Frame')
    fade_start = _read_int(node, 'Fade_Start_Frame')
    fade_end = _read_int(node, 'Fade_End_Frame')
    if frame_range_on and fade_on:
        _apply_fade(mix, first, last, fade_start, fade_end)
    elif frame_range_on:
        _apply_frame_range(mix, first, last)
    else:
        _apply_single_frame(mix, _read_int(node, 'Frame'))

def _handle_frame_range_toggle(node):
    on = bool(node['Frame_Range'].value())
    _set_enabled(node, ['Settocurrentframe', 'Frame'], not on)
    _set_enabled(node, ['First_Frame', 'Last_Frame', 'Fade'], on)

def _handle_fade_toggle(node):
    on = bool(node['Fade'].value())
    _set_enabled(node, ['Fade_Start_Frame', 'Fade_End_Frame'], on)

n = nuke.thisNode()
k = nuke.thisKnob()
name = k.name()

try:
    handler = {'Frame_Range': _handle_frame_range_toggle,
               'Fade': _handle_fade_toggle}.get(name)
    if handler:
        handler(n)
    if name in ('Frame_Range', 'Fade', 'Frame', 'First_Frame', 'Last_Frame',
                'Fade_Start_Frame', 'Fade_End_Frame'):
        _update_animation(n)
except Exception:
    import traceback
    traceback.print_exc()

 }
 onCreate "n = nuke.thisNode(); n.knob(\"Settocurrentframe\").execute(); n['onCreate'].setValue('')"
